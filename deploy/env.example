# Environment variables for the family-sync server.
#
# Read by loadConfig() in server/src/main/kotlin/family/sync/Config.kt, which is
# the authoritative list. This file documents them; nothing loads it at runtime,
# it is a checklist for Render's Environment tab.
#
# In Render, set these on the service's Environment page, not in this file.
# Never commit a filled-in copy of this file.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Postgres connection URI. `postgresql://…` and `postgres://…` are accepted, as
# is a full `jdbc:postgresql://…` URL. Config.kt strips any `user:password@`
# section and any existing `sslmode` parameter, then appends `sslmode=` from
# DATABASE_SSL_MODE.
#
# For Supabase use the SESSION POOLER on port 5432:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Do not use the transaction pooler on port 6543: Flyway needs advisory locks,
# which transaction pooling does not provide.
#
# The username embedded here IS honoured: Config.kt reads it out of the
# connection string and uses it unless DATABASE_USER overrides it. Passwords are
# still stripped from the URL, because Hikari supplies them.
DATABASE_URL=

# Database role. OPTIONAL — only needed to override the username embedded in
# DATABASE_URL. Deliberately NOT in render.yaml, so Render does not prompt for it:
# asking for a value invites an operator to type a bare `postgres`, which the
# Supabase shared pooler rejects with
# `FATAL: (ENOTFOUND) tenant/user postgres. not found`.
# For that pooler the URL's own username must be `postgres.<project-ref>`. A bare
# `postgres` is correct only for the Supabase *direct* connection.
DATABASE_USER=

# Database password. SECRET and REQUIRED. Config.kt refuses to start on a blank
# or missing value, so an unset password fails immediately with a named error
# instead of an opaque Postgres authentication error inside a Flyway stack
# trace. See OPERATIONS.md for how to rotate it.
DATABASE_PASSWORD=

# ---------------------------------------------------------------------------
# OPTIONAL — SAFE TO LEAVE AT THE DEFAULT
# ---------------------------------------------------------------------------

# TLS mode appended to the JDBC URL. One of: disable, allow, prefer, require,
# verify-ca, verify-full. Default `require`, which is correct for Supabase and
# is already pinned in render.yaml. Only lower it for a local Postgres.
DATABASE_SSL_MODE=require

# TCP port to listen on. Render injects this itself, around 10000. Leave it unset
# on Render and do not add it to render.yaml. Default 8080 is for local runs.
PORT=

# ---------------------------------------------------------------------------
# OPTIONAL — TUNABLE, SAFE TO LEAVE UNSET
# ---------------------------------------------------------------------------

# Bearer-token lifetime in days, as a decimal. Unset means 3650 days.
#
# This is a window on the token's created_at, so it is applied RETROACTIVELY:
# lowering it invalidates every token already minted inside the new window, and
# every enrolled device then gets a 401 with no way back in short of enrolling
# again. Lower it only alongside a re-enrol plan, and only downward if you have
# checked how old your live tokens are.
TOKEN_LIFETIME_DAYS=

# Re-read Config.kt and SecuritySettings.kt before trusting this file as a
# complete list — it is a snapshot of 2026-10-01.